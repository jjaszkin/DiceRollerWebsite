  "glide_oracle": {
    "description": "Rolą systemu wyroczni Glide jest pomoc graczom w budowaniu narracji poprzez odpowiadanie na proste pytania. Przybierają one formę Pytań Tak/Nie oraz Pytań Otwartych. Wyrocznia jest opcjonalna i może być używana jako uzupełnienie pozostałych zasad podstawowych.",
    "yes_no_questions": {
      "rule": "Zadaj wyroczni pytanie, na które można odpowiedzieć tak lub nie. Odpowiedź \"tak\" nie musi być pozytywna, np. \"Czy strażnicy Domu mnie widzą?\". Rzuć d10 i porównaj wynik z poniższą tabelą, następnie rzuć w odpowiedniej tabeli poniżej, by uzyskać dalszy wynik na podstawie swojego rezultatu.",
      "table_d10": [
        {"range": "1-2", "result": "No, and…", "result_pl": "Nie, i… (negatywna z komplikacją)"},
        {"range": "3-4", "result": "No", "result_pl": "Nie (negatywna)"},
        {"range": "5", "result": "No, but…", "result_pl": "Nie, ale… (negatywna, z plusem)"},
        {"range": "6-7", "result": "Yes, but…", "result_pl": "Tak, ale… (pozytywna z komplikacją)"},
        {"range": "8-9", "result": "Yes", "result_pl": "Tak (pozytywna)"},
        {"range": "10", "result": "Yes, and…", "result_pl": "Tak, i… (pozytywna, z bonusem)"}
      ],
      "sub_tables": {
        "no_and": {
          "name": "NO, AND… (1-2)",
          "description": "Porażka z negatywną eskalacją.",
          "table_d10": [
            {"range": "1-3", "text": "Zasób zostaje wyczerpany."},
            {"range": "4-5", "text": "Pojawia się nowe zagrożenie."},
            {"range": "6-7", "text": "Twoja pozycja jest niekorzystna."},
            {"range": "8-9", "text": "Ściągasz na siebie niepożądaną uwagę."},
            {"range": "10", "text": "Tracisz okazję."}
          ]
        },
        "no": {
          "name": "NO (3-4)",
          "description": "To się nie wydarza.",
          "table_d10": [
            {"range": "1-2", "text": "Okoliczności na to nie pozwalają."},
            {"range": "3", "text": "Nigdy nie było to możliwe."},
            {"range": "5-6", "text": "Byłeś zbyt późno."},
            {"range": "7", "text": "Ryzyko jest zbyt duże."},
            {"range": "8-9", "text": "Przyjmij inne podejście."},
            {"range": "10", "text": "Okazja przeminęła."}
          ],
          "note": "w źródle brak zakresu dla wyniku 4 (skok z 3 na 5) - prawdopodobny błąd druku"
