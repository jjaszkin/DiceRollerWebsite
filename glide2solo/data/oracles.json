            {"range": "6-7", "text": "Zyskujesz przewagę (Advantage)."},
            {"range": "8-10", "text": "Żadne zasoby nie zostają wydane."}
          ]
        },
        "yes_but": {
          "name": "YES, BUT… (6-7)",
          "description": "To działa, ale kosztem lub z ograniczeniem.",
          "table_d10": [
